[
  {
    "id": "f0000000-0000-4000-8000-000000000001",
    "channel": "c0000000-0000-4000-8000-000000000001",
    "body": [
      {
        "type": "paragraph",
        "text": "来週月曜は全社朝会です。9時に大会議室へ集まってください。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000002",
    "channel": "c0000000-0000-4000-8000-000000000001",
    "body": [
      {
        "type": "paragraph",
        "text": "社内システムのメンテナンスは土曜の夜に行います。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000003",
    "channel": "c0000000-0000-4000-8000-000000000001",
    "body": [
      {
        "type": "paragraph",
        "text": "新しい経費精算の手順を wiki に載せました。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000004",
    "channel": "c0000000-0000-4000-8000-000000000001",
    "body": [
      {
        "type": "paragraph",
        "text": "健康診断の予約は今月末までです。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000005",
    "channel": "c0000000-0000-4000-8000-000000000001",
    "body": [
      {
        "type": "paragraph",
        "text": "夏季休暇の申請を受け付けています。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000006",
    "channel": "c0000000-0000-4000-8000-000000000001",
    "body": [
      {
        "type": "paragraph",
        "text": "会議室Bのプロジェクターは修理中です。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000007",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "新製品「サンプルライト」の発売時期を相談したいです。3月でどうでしょう。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000008",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "3月で賛成です。工場の立ち上げが2月中に終わる見込みです。"
      }
    ],
    "thread_root": "f0000000-0000-4000-8000-000000000007"
  },
  {
    "id": "f0000000-0000-4000-8000-000000000009",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "価格は据え置きで行きましょう。原価は先月と変わりません。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000010",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "了解です。価格は据え置きで決定とします。"
      }
    ],
    "thread_root": "f0000000-0000-4000-8000-000000000009"
  },
  {
    "id": "f0000000-0000-4000-8000-000000000011",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "パッケージの色は白か青で迷っています。意見をください。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000012",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "店頭で目立つのは青だと思います。"
      }
    ],
    "thread_root": "f0000000-0000-4000-8000-000000000011"
  },
  {
    "id": "f0000000-0000-4000-8000-000000000013",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "白のほうが製品の清潔感が伝わります。"
      }
    ],
    "thread_root": "f0000000-0000-4000-8000-000000000011"
  },
  {
    "id": "f0000000-0000-4000-8000-000000000014",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "色は次回の定例で決めましょう。担当は山本さんでお願いします。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000015",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "取扱説明書の初稿ができました。確認をお願いします。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000016",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "3ページ目の図が古いので差し替えます。"
      }
    ],
    "thread_root": "f0000000-0000-4000-8000-000000000015"
  },
  {
    "id": "f0000000-0000-4000-8000-000000000017",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "展示会への出品は今回は見送り、ウェブ公開を優先します。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000018",
    "channel": "c0000000-0000-4000-8000-000000000002",
    "body": [
      {
        "type": "paragraph",
        "text": "発売日の告知文の案を共有します。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000019",
    "channel": "c0000000-0000-4000-8000-000000000003",
    "body": [
      {
        "type": "paragraph",
        "text": "今月の商談は10件、うち2件が受注です。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000020",
    "channel": "c0000000-0000-4000-8000-000000000003",
    "body": [
      {
        "type": "paragraph",
        "text": "青葉精機の保守契約は来週提案します。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000021",
    "channel": "c0000000-0000-4000-8000-000000000003",
    "body": [
      {
        "type": "paragraph",
        "text": "見積の承認ルールを共有しました。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000022",
    "channel": "c0000000-0000-4000-8000-000000000003",
    "body": [
      {
        "type": "paragraph",
        "text": "来週の営業会議の議題を募集します。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000023",
    "channel": "c0000000-0000-4000-8000-000000000003",
    "body": [
      {
        "type": "paragraph",
        "text": "新しい料金表をアップロードしました。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000024",
    "channel": "c0000000-0000-4000-8000-000000000003",
    "body": [
      {
        "type": "paragraph",
        "text": "顧客訪問の日程を調整中です。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000025",
    "channel": "c0000000-0000-4000-8000-000000000004",
    "body": [
      {
        "type": "paragraph",
        "text": "溶接工程の不良率が先週より下がりました。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000026",
    "channel": "c0000000-0000-4000-8000-000000000004",
    "body": [
      {
        "type": "paragraph",
        "text": "原因はシールドガスの流量調整でした。"
      }
    ],
    "thread_root": "f0000000-0000-4000-8000-000000000025"
  },
  {
    "id": "f0000000-0000-4000-8000-000000000027",
    "channel": "c0000000-0000-4000-8000-000000000004",
    "body": [
      {
        "type": "paragraph",
        "text": "検査手順書を改訂しました。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000028",
    "channel": "c0000000-0000-4000-8000-000000000004",
    "body": [
      {
        "type": "paragraph",
        "text": "ライン2の再教育を水曜に行います。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000029",
    "channel": "c0000000-0000-4000-8000-000000000004",
    "body": [
      {
        "type": "paragraph",
        "text": "出荷前検査のチェック項目を2つ追加します。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000030",
    "channel": "c0000000-0000-4000-8000-000000000004",
    "body": [
      {
        "type": "paragraph",
        "text": "不良品の廃棄ルールを確認してください。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000031",
    "channel": "c0000000-0000-4000-8000-000000000005",
    "body": [
      {
        "type": "paragraph",
        "text": "来期の採用計画を共有します。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000032",
    "channel": "c0000000-0000-4000-8000-000000000005",
    "body": [
      {
        "type": "paragraph",
        "text": "予算の見直しは来月に実施します。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000033",
    "channel": "c0000000-0000-4000-8000-000000000005",
    "body": [
      {
        "type": "paragraph",
        "text": "評価面談の日程を調整してください。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000034",
    "channel": "c0000000-0000-4000-8000-000000000005",
    "body": [
      {
        "type": "paragraph",
        "text": "拠点間の異動案を確認してください。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000035",
    "channel": "c0000000-0000-4000-8000-000000000005",
    "body": [
      {
        "type": "paragraph",
        "text": "来週のリーダー会議は15時からです。"
      }
    ]
  },
  {
    "id": "f0000000-0000-4000-8000-000000000036",
    "channel": "c0000000-0000-4000-8000-000000000005",
    "body": [
      {
        "type": "paragraph",
        "text": "研修の講師候補をリストにしました。"
      }
    ]
  }
]
