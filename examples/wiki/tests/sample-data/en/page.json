      {
        "type": "heading1",
        "text": "Travel expense claims"
      },
      {
        "type": "paragraph",
        "text": "Public transport is reimbursed at cost. Taxis only after the last train or with heavy luggage."
      }
    ],
    "space": "c0000000-0000-4000-8000-000000000001"
  },
  {
