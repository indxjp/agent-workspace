      {
        "type": "heading1",
        "text": "Expense policy"
      },
      {
        "type": "paragraph",
        "text": "Claim expenses within 30 days. Anything over 30,000 yen needs prior approval from your manager."
      },
      {
        "type": "paragraph",
        "text": "A receipt is required. Private spending is not covered."
      }
    ],
    "space": "c0000000-0000-4000-8000-000000000001"
  },
  {
