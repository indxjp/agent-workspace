exports[`the generator templates > recipe: writes exactly the recipe and its test, for each trigger (#1514) 1`] = `
"import { defineRecipe, resourceEvent } from '@indx-workspace/app';

/** The agent the example step asks: set AW_ENRICH_CONTACT_AGENT_ID to its Agent Workspace id. */
export const AGENT = process.env['AW_ENRICH_CONTACT_AGENT_ID'] ?? 'enrich-contact-agent';

/**
 * Enrich contact: the app runs it when a contact is created.
 *
 * Each step runs once: its key is the idempotency key of the one Agent Workspace run it may
 * start, so after a restart the recipe resumes rather than repeats. Keep each step safe to run
 * again until it completes.
 */
export default defineRecipe({
  name: 'enrich-contact',
  on: resourceEvent('contact', 'created'),
  async run({ aw, step }) {
    await step('first-step', async () => {
      const prompt = 'Do the first step of enrich-contact.';
      const { result } = await aw.runs.start(AGENT, { prompt });
      return (await result).text;
    });
  },
});
"
`;

exports[`the generator templates > recipe: writes exactly the recipe and its test, for each trigger (#1514) 2`] = `
"import assert from 'node:assert/strict';
import { test } from 'node:test';

import { completed, recipeHarness } from '@indx-workspace/app/testing';

import recipe, { AGENT } from '../../recipes/enrich-contact.ts';

void test('enrich-contact completes, starting one run for its step', async () => {
  const harness = recipeHarness(recipe, { agents: { [AGENT]: [completed('done')] } });

  const run = await harness.start({
    resource: 'contact',
    event: 'created',
    record: { id: '00000000-0000-4000-8000-000000000001' },
  });

  assert.equal(run.status, 'completed');
  assert.equal(harness.runsStarted().length, 1);
});
"
`;

exports[`the generator templates > recipe: writes exactly the recipe and its test, for each trigger (#1514) 3`] = `
"import { defineRecipe, schedule } from '@indx-workspace/app';

/** The agent the example step asks: set AW_SLA_SWEEP_AGENT_ID to its Agent Workspace id. */
export const AGENT = process.env['AW_SLA_SWEEP_AGENT_ID'] ?? 'sla-sweep-agent';

/**
 * Sla sweep: the app runs it on each slot of its schedule, in UTC.
 *
 * Each step runs once: its key is the idempotency key of the one Agent Workspace run it may
 * start, so after a restart the recipe resumes rather than repeats. Keep each step safe to run
 * again until it completes.
 */
export default defineRecipe({
  name: 'sla-sweep',
  on: schedule('*/5 * * * *', 'UTC'),
  async run({ aw, step }) {
    await step('first-step', async () => {
      const prompt = 'Do the first step of sla-sweep.';
      const { result } = await aw.runs.start(AGENT, { prompt });
      return (await result).text;
    });
  },
});
"
`;

exports[`the generator templates > recipe: writes exactly the recipe and its test, for each trigger (#1514) 4`] = `
"import assert from 'node:assert/strict';
import { test } from 'node:test';

import { completed, recipeHarness } from '@indx-workspace/app/testing';

import recipe, { AGENT } from '../../recipes/sla-sweep.ts';

void test('sla-sweep completes, starting one run for its step', async () => {
  const harness = recipeHarness(recipe, { agents: { [AGENT]: [completed('done')] } });

  const run = await harness.start({ slot: '2026-01-01T00:05:00.000Z' });

  assert.equal(run.status, 'completed');
  assert.equal(harness.runsStarted().length, 1);
});
"
`;

