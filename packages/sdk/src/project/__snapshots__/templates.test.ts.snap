exports[`the generator templates > wires the agent to the app connector 1`] = `
"import { defineAgent, mcp } from '@indx-workspace/sdk/define';

export default defineAgent({
  name: 'triage',
  description: 'Works with tickets in the service-desk app.',
  instructions: [
    'You work in the service-desk app for the person who asked, through its tools:',
    'tickets: ticket_list and ticket_get read them, ticket_search finds them when the resource is searchable, and ticket_update changes the fields agents may write.',
    'Each tool acts as that person, so it refuses what they may not do; say so instead of retrying.',
  ].join('\\n'),
  tools: [mcp('service-desk')],
});
"
`;

exports[`the generator templates > writes the resource file from the parsed fields 1`] = `
"import {
  bool,
  date,
  dateTime,
  defineResource,
  enumOf,
  files,
  money,
  number,
  person,
  ref,
  richText,
  tags,
  text,
} from '@indx-workspace/app';

export default defineResource({
  name: 'ticket',
  fields: {
    title: text({ max: 200 }),
    description: richText(),
    estimate: number({ min: 0, max: 100, optional: true }),
    budget: money({ currency: 'JPY' }),
    urgent: bool(),
    due: date({ optional: true }),
    opened_at: dateTime(),
    status: enumOf(['new', 'in_progress', 'closed']),
    assignee: person({ optional: true }),
    parent: ref('ticket', { optional: true }),
    attachments: files(),
    labels: tags(),
  },
  access: {
    read: 'member',
    create: 'member',
    update: 'member',
    delete: 'role:admin',
  },
  // Agents act for a person and never exceed that person's access. List the fields they may
  // change, such as write: ['status'], to give them the ticket_update tool.
  agents: { read: true, write: false },
  search: ['title', 'description'],
  board: 'status',
});
"
`;

exports[`the generator templates > writes the resource file from the parsed fields 2`] = `
"import assert from 'node:assert/strict';
import { test } from 'node:test';

import { fakePerson, memoryStoreOf } from '@indx-workspace/app/testing';

import resource from '../resources/ticket.ts';

const record = {
  title: 'example',
  description: [{ type: 'paragraph', text: 'Example' }],
  budget: { amount: '100', currency: 'JPY' },
  urgent: true,
  opened_at: '2026-01-01T09:00:00Z',
  status: 'new',
  attachments: [],
  labels: [],
};

test('a member creates a ticket and lists it', async () => {
  const store = memoryStoreOf(resource);
  const member = fakePerson({ role: 'builder' });

  const created = await store.create(member, record);
  const page = await store.list(member, {});

  assert.deepEqual(
    page.items.map((row) => row.id),
    [created.id],
  );
});

test('a builder may not delete a ticket: delete is role:admin', async () => {
  const store = memoryStoreOf(resource);
  const builder = fakePerson({ role: 'builder' });
  const created = await store.create(builder, record);

  await assert.rejects(store.delete(builder, created.id), { code: 'forbidden' });
});
"
`;

