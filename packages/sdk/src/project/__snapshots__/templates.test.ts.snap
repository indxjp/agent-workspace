exports[`the generator templates > channel: writes the channel, its events route and its page, keyed on the first ref() to another resource (#1519) 1`] = `
"import roomResource from '@/resources/room';
import { channel } from '@indx-workspace/app/server';

// Every write of a message, through its routes or an agent tool, is published to the room
// its \`room\` field names. Whoever may read that room follows it at
// /api/channels/message/events?key=<the room's id>.
export default channel('message', { resource: roomResource, key: 'room' });
"
`;

