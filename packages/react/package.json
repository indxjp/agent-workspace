{
  "name": "@indx-workspace/react",
  "version": "0.6.9",
  "description": "The hosted surface chat as React: <Chat/> with replaceable parts, and the headless useConversation() hook.",
  "license": "Apache-2.0",
  "homepage": "https://docs.agentworkspace.indx.jp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indxjp/agent-workspace.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/indxjp/agent-workspace/issues"
  },
  "keywords": [
    "agent-workspace",
    "claude",
    "ai-agents",
    "react",
    "chat"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./locale": {
      "types": "./src/locale.ts",
      "default": "./dist/locale.js"
    },
    "./run-model": {
      "types": "./src/run-model.ts",
      "default": "./dist/run-model.js"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "default": "./dist/theme.js"
    },
    "./styles.css": {
      "types": "./src/styles.d.css.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./locale": {
        "types": "./dist/locale.d.ts",
        "default": "./dist/locale.js"
      },
      "./run-model": {
        "types": "./dist/run-model.d.ts",
        "default": "./dist/run-model.js"
      },
      "./theme": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme.js"
      },
      "./styles.css": {
        "types": "./dist/styles.d.css.ts",
        "default": "./dist/styles.css"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const f of ['styles.css','styles.d.css.ts']) require('node:fs').cpSync('src/'+f,'dist/'+f)\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19"
  },
  "dependencies": {
    "@indx-workspace/contracts": "workspace:*",
    "@indx-workspace/sdk": "workspace:*",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3"
  },
  "nx": {
    "targets": {
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint packages/react --max-warnings 0"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --project @indx-workspace/react --reporter=default --reporter=json --outputFile={projectRoot}/.vitest-report.json",
          "env": {
            "NODE_OPTIONS": "--unhandled-rejections=strict",
            "VITEST_MAX_WORKERS": "4"
          }
        }
      }
    }
  }
}
