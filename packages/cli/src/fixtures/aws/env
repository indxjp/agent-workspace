# Generated by create-agent-workspace from agent-workspace.yaml.
# `agent-workspace render` rewrites only the image lines below from agent-workspace.yaml;
# every other line is yours to edit and keeps its value. Replace every secret before exposure.
# Images are immutable process contracts, pinned by digest.
WEB_IMAGE=registry.example/web@sha256:1111111111111111111111111111111111111111111111111111111111111111
GATEWAY_IMAGE=registry.example/gateway@sha256:2222222222222222222222222222222222222222222222222222222222222222
RUNNER_IMAGE=registry.example/runner@sha256:3333333333333333333333333333333333333333333333333333333333333333
AGENT_WORKSPACE_RUNTIME_IMAGE_CLAUDE_AGENT_SDK=registry.example/runtime@sha256:4444444444444444444444444444444444444444444444444444444444444444
DOCKER_GID=0
# Relational store: rds
# You provision it and put its URL in the Secret the chart names in external.databaseUrlSecret.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
# Object store: s3://acme-ai-files
SEAWEEDFS_ACCESS_KEY_ID=
SEAWEEDFS_SECRET_ACCESS_KEY=
COMPOSE_PROFILES=
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=acme-ai-files
# The two keys below are the cloud's to supply: the pod's IAM role or workload identity, or a
# key held by the cloud's own key service. Leave both empty when the service account itself
# grants the bucket — the S3 client then signs with the identity the pod already has.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
AW_FILE_STORAGE_ROOT=/var/lib/agent-workspace/files
AW_SKILL_STORAGE_ROOT=/var/lib/agent-workspace/skills
AW_SESSION_TRANSCRIPT_ROOT=/var/lib/agent-workspace/sessions
# Runtime: kubernetes
RUNTIME_DRIVER=kubernetes
# The three addresses below are the Services infra/helm/agent-workspace publishes; a
# Cloud Run or Container Apps deployment is given them by its Terraform module instead.
# RUNNER_URL has no fixed address in either: the runner-manager creates each sandbox
# and returns its address per run, so there is no runner Service to name.
RUNNER_URL=
RUNNER_MANAGER_URL=http://agent-workspace-runner-manager:8080
RUNNER_MANAGER_TOKEN=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
# Replace this sentinel with reviewed provider:model rates before the first run: until then
# every run settles unpriced (cost 0.000000, accountingState "unavailable").
GATEWAY_PRICING_JSON={"version":"unconfigured","models":{"disabled:unconfigured":{"inputUsdPerMillion":"0","outputUsdPerMillion":"0"}}}
MODEL_GATEWAY_URL=http://agent-workspace-gateway:4000
AW_SESSION_MIRROR_URL=http://agent-workspace-web:3000
WORKSPACE_SLUG=default
WORKSPACE_NAME=Default Workspace
# Secret backend: local-key
MASTER_KEY_PROVIDER=local-key
AZURE_KEY_VAULT_URL=
AZURE_MASTER_KEY_SECRET_NAME=
GCP_MASTER_KEY_SECRET=
BOOTSTRAP_ADMIN=admin@localhost.test
BOOTSTRAP_ADMIN_PASSWORD=admin-password
SESSION_SECRET=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
MASTER_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GATEWAY_TOKEN_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Exact count of proxies that prepend X-Forwarded-For; public shares fail closed if it is wrong.
AW_TRUSTED_PROXY_HOPS=1
