# Generated by create-agent-workspace from agent-workspace.yaml.
# `agent-workspace render` rewrites only the image lines below from agent-workspace.yaml;
# every other line is yours to edit and keeps its value. Replace every secret before exposure.
# Images are immutable process contracts, pinned by digest.
# The Compose project, and its runtime-control and provider-egress networks, are named
# after this directory, so projects on one Docker host never adopt each other. Two
# directories with the same name share it: set a distinct name here to run both.
COMPOSE_PROJECT_NAME=acme-ai
WEB_IMAGE=registry.example/web@sha256:1111111111111111111111111111111111111111111111111111111111111111
GATEWAY_IMAGE=registry.example/gateway@sha256:2222222222222222222222222222222222222222222222222222222222222222
RUNNER_IMAGE=registry.example/runner@sha256:3333333333333333333333333333333333333333333333333333333333333333
AGENT_WORKSPACE_RUNTIME_IMAGE_CLAUDE_AGENT_SDK=registry.example/runtime@sha256:4444444444444444444444444444444444444444444444444444444444444444
POSTGRES_IMAGE=registry.example/postgres@sha256:5555555555555555555555555555555555555555555555555555555555555555
SEAWEEDFS_IMAGE=registry.example/seaweedfs@sha256:6666666666666666666666666666666666666666666666666666666666666666
DOCKER_GID=0
# Relational store: compose-postgres
POSTGRES_USER=agent_workspace
POSTGRES_PASSWORD=postgres-password
POSTGRES_DB=agent_workspace
DATABASE_URL=postgres://agent_workspace:postgres-password@postgres:5432/agent_workspace
# Object store: s3://agent-workspace
SEAWEEDFS_ACCESS_KEY_ID=agent_workspace
SEAWEEDFS_SECRET_ACCESS_KEY=object-store-secret
# The loopback host port SeaweedFS is published on. Change it to run beside another project
# that uses 8333, and change the publicEndpoint port in AW_STORAGE_URL with it.
SEAWEEDFS_PORT=8333
# The origins a browser may upload to SeaweedFS from through a signed link: the web service
# in both loopback spellings, never `*`. Change it with PORT or when serving a public hostname.
SEAWEEDFS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMPOSE_PROFILES=object-storage
# Where files, skills and session transcripts live, in one URL. No key or password belongs in
# it: the credential lines below, or the workload identity, supply those.
AW_STORAGE_URL=s3://agent-workspace?endpoint=http://seaweedfs:8333&publicEndpoint=http://localhost:8333&pathStyle=true
# The bundled SeaweedFS starts empty: the server creates the bucket on first boot.
AW_STORAGE_CREATE_BUCKET=true
# Largest signed upload in bytes. Blank keeps the server default, 5 GiB.
AW_STORAGE_SIGNED_UPLOAD_MAX_BYTES=
OBJECT_STORAGE_ACCESS_KEY_ID=agent_workspace
OBJECT_STORAGE_SECRET_ACCESS_KEY=object-store-secret
AWS_REGION=us-east-1
# Runtime: docker
RUNTIME_DRIVER=docker
RUNNER_URL=http://runner:8080
RUNNER_MANAGER_URL=http://runner:8090
RUNNER_MANAGER_TOKEN=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
# Replace this sentinel with reviewed provider:model rates before the first run: until then
# every run settles unpriced (cost 0.000000, accountingState "unavailable").
GATEWAY_PRICING_JSON={"version":"unconfigured","models":{"disabled:unconfigured":{"inputUsdPerMillion":"0","outputUsdPerMillion":"0"}}}
MODEL_GATEWAY_URL=http://gateway:4000
AW_SESSION_MIRROR_URL=http://web:3000
WORKSPACE_SLUG=default
WORKSPACE_NAME=Default Workspace
# Secret backend: local-key
MASTER_KEY_PROVIDER=local-key
AZURE_KEY_VAULT_URL=
AZURE_MASTER_KEY_SECRET_NAME=
GCP_MASTER_KEY_SECRET=
BOOTSTRAP_ADMIN=admin@localhost.test
BOOTSTRAP_ADMIN_PASSWORD=admin-password
SESSION_SECRET=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
MASTER_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GATEWAY_TOKEN_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Exact count of proxies that prepend X-Forwarded-For; public shares fail closed if it is wrong.
AW_TRUSTED_PROXY_HOPS=0
# The host address and port the web service is published on, loopback only by default.
# Change the port when 3000 is taken, or to run a second generated project beside this
# one; `agent-workspace start` checks it is free before it starts anything. Write the
# port alone (PORT=3000) to publish on every interface, e.g. for a remote Docker daemon.
PORT=127.0.0.1:3000
