SEAWEEDFS_IMAGE=registry.example/seaweedfs@sha256:6666666666666666666666666666666666666666666666666666666666666666
DOCKER_GID=0
# Relational store: compose-postgres
POSTGRES_USER=agent_workspace
POSTGRES_PASSWORD=postgres-password
POSTGRES_DB=agent_workspace
DATABASE_URL=postgres://agent_workspace:postgres-password@postgres:5432/agent_workspace
# Object store: s3://agent-workspace
SEAWEEDFS_ACCESS_KEY_ID=agent_workspace
SEAWEEDFS_SECRET_ACCESS_KEY=object-store-secret
