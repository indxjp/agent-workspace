{
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile --filter \"{.}...\"",
  "buildCommand": "pnpm --filter \"{.}^...\" run build && pnpm run build",
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/triggers",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 5 * * *"
    }
  ]
}
