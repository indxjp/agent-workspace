{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "images",
    "replicas",
    "rollout",
    "migrations",
    "probes",
    "podDisruptionBudget",
    "autoscaling",
    "serviceAccount",
    "external",
    "secrets"
  ],
  "properties": {
    "images": {
      "type": "object",
      "required": ["web", "gateway", "runnerManager", "runtime"],
      "properties": {
        "web": {
          "type": "string",
          "pattern": "^[^:/]+(?::[0-9]+)?(?:/[^:]+)+@sha256:[0-9a-f]{64}$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^[^:/]+(?::[0-9]+)?(?:/[^:]+)+@sha256:[0-9a-f]{64}$"
        },
        "runnerManager": {
          "type": "string",
          "pattern": "^[^:/]+(?::[0-9]+)?(?:/[^:]+)+@sha256:[0-9a-f]{64}$"
        },
        "runtime": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[^:/]+(?::[0-9]+)?(?:/[^:]+)+@sha256:[0-9a-f]{64}$"
              }
            },
            {
              "type": "string",
              "pattern": "^[^:/]+(?::[0-9]+)?(?:/[^:]+)+@sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "replicas": {
      "type": "object",
      "required": ["web", "gateway", "runnerManager"],
      "properties": {
        "web": { "type": "integer", "minimum": 1 },
        "gateway": { "type": "integer", "minimum": 1 },
        "runnerManager": { "type": "integer", "minimum": 1 }
      }
    },
    "rollout": {
      "type": "object",
      "required": [
        "revision",
        "minReadySeconds",
        "progressDeadlineSeconds",
        "maxUnavailable",
        "maxSurge"
      ],
      "properties": {
        "revision": { "type": "string" },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "maxUnavailable": { "type": ["integer", "string"] },
        "maxSurge": { "type": ["integer", "string"] }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "backoffLimit", "activeDeadlineSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "probes": {
      "type": "object",
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": { "$ref": "#/definitions/basicProbe" },
        "readiness": { "$ref": "#/definitions/basicProbe" },
        "liveness": {
          "allOf": [
            { "$ref": "#/definitions/basicProbe" },
            {
              "type": "object",
              "required": ["timeoutSeconds"],
              "properties": { "timeoutSeconds": { "type": "integer", "minimum": 1 } }
            }
          ]
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "maxUnavailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cidr": { "type": "string", "pattern": "^$|^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
        "podSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "namespace": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": { "type": "string", "minLength": 1 },
        "egressProxyImage": {
          "type": "string",
          "pattern": "^$|^[^:/]+(?::[0-9]+)?(?:/[^:]+)+@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cidr": { "type": "string", "pattern": "^$|^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
        "podSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "namespace": { "type": "string" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^$|^(?:s3|gcs|azblob|file)://" }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cidr": { "type": "string", "pattern": "^$|^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
        "except": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" }
        },
        "podSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "namespace": { "type": "string" }
      }
    },
    "kubernetesApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidr": { "type": "string", "pattern": "^$|^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
        "ports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "podSelector": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "controllerNamespace": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "clusterIssuer": { "type": "string" } }
        }
      }
    },
    "deploymentPolicy": { "type": "string" },
    "deploymentFeatures": { "type": "string", "pattern": "^([a-z]+(,[a-z]+)*)?$" },
    "publicUrl": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "required": ["name", "annotations"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "basicProbe": {
      "type": "object",
      "required": ["failureThreshold", "periodSeconds"],
      "properties": {
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "periodSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
