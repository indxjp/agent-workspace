{
  "root": "support-triage",
  "agents": [
    {
      "apiVersion": "agentworkspace.dev/v1",
      "kind": "Agent",
      "name": "support-triage",
      "description": "Triages customer support tickets and drafts replies.",
      "instructions": "You triage support tickets.\n\n- Look up the order before answering.\n- Hand billing questions to billing-specialist.",
      "permissions": {
        "readFiles": false,
        "writeFiles": false,
        "runCommands": false,
        "unrestrictedNetwork": false
      },
      "tools": [
        {
          "kind": "builtin",
          "id": "web_search"
        },
        {
          "kind": "builtin",
          "id": "code_execution"
        }
      ],
      "skills": [],
      "knowledge": [
        {
          "kind": "files",
          "paths": ["knowledge/faq.md"]
        },
        {
          "kind": "url",
          "url": "https://help.example.com"
        }
      ],
      "subagents": [
        {
          "name": "billing-specialist"
        }
      ],
      "extensions": {
        "platforms": {
          "copilot-studio": {
            "schemaName": "acme_supportTriage",
            "publisherPrefix": "acme",
            "topics": {
              "greeting": "kind: AdaptiveDialog\nbeginDialog:\n  kind: OnRecognizedIntent\n"
            }
          }
        }
      }
    },
    {
      "apiVersion": "agentworkspace.dev/v1",
      "kind": "Agent",
      "name": "billing-specialist",
      "description": "Answers billing and refund questions.",
      "instructions": "You answer billing questions using the refund-policy skill.",
      "permissions": {
        "readFiles": false,
        "writeFiles": false,
        "runCommands": false,
        "unrestrictedNetwork": false
      },
      "tools": [],
      "skills": [],
      "knowledge": [],
      "subagents": []
    }
  ],
  "skills": [],
  "knowledgeFiles": [
    {
      "path": "knowledge/faq.md",
      "content": "# FAQ\n\nOrders ship in 2 days.\n"
    }
  ],
  "openapiSpecs": []
}
