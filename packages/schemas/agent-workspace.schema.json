              "pattern": "^(?:[sS]3:\\/\\/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9])$",
              "type": "string"
            },
            "relational": {
              "description": "A postgres:// or postgresql:// connection string, or rds, the PostgreSQL cloud \"aws\" names.",
              "examples": ["rds"],
              "minLength": 1,
              "pattern": "^(?:[pP][oO][sS][tT][gG][rR][eE][sS](?:[qQ][lL])?:\\/\\/|(?:rds)$)",
              "type": "string"
            },
            "secrets": {
              "description": "Where cloud \"aws\" keeps the secrets it encrypts.",
              "enum": ["local-key", "kms"],
              "type": "string"
            }
          },
          "required": ["relational", "objects", "secrets"],
          "type": "object"
        }
      },
      "required": ["cloud", "storage", "runtime", "identity"],
