        "apiVersion": { "const": "agentworkspace.dev/v1", "type": "string" },
        "cloud": { "const": "aws", "type": "string" },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "bootstrapAdmin": {
              "description": "The first workspace Owner's sign-in identity, an email address.",
              "minLength": 1,
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "type": "string"
            },
            "oidc": {
              "description": "The https:// issuer URL of the OIDC provider people sign in through.",
              "minLength": 1,
              "pattern": "^[hH][tT][tT][pP][sS]:\\/\\/",
              "type": "string"
            }
          },
          "required": ["bootstrapAdmin"],
          "type": "object"
        },
        "kind": { "const": "Deployment", "type": "string" },
        "runtime": {
          "additionalProperties": false,
          "properties": {
            "default": {
              "description": "The sandbox driver an agent's runtime profile falls back to.",
              "enum": ["local", "docker", "kubernetes", "cloud-run-service", "aca-sessions"],
              "type": "string"
            }
          },
          "required": ["default"],
          "type": "object"
        },
        "storage": {
          "additionalProperties": false,
          "properties": {
            "objects": {
              "description": "The object store cloud \"aws\" keeps files in: s3://<bucket>.",
