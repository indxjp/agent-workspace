              },
              "required": ["mode"],
              "additionalProperties": false
            },
            {
              "readOnly": true,
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "allowlist"
                },
                "names": {
                  "readOnly": true,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
                  }
                }
              },
              "required": ["mode", "names"],
              "additionalProperties": false
            }
          ]
        },
        "limits": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "maxTurns": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxBudgetUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["maxTurns", "maxBudgetUsd"],
          "additionalProperties": false
        }
      },
      "required": ["engine", "skills", "limits"],
      "additionalProperties": false
    },
    {
