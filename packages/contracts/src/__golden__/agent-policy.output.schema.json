{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "const": "claude-agent-sdk"
        },
        "tools": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "base": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "claude_code_preset"
                },
                {
                  "readOnly": true,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "autoApprove": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deny": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "permissionMode": {
              "type": "string",
              "enum": ["default", "acceptEdits", "bypassPermissions", "plan", "dontAsk", "auto"]
            },
            "allowDangerouslySkipPermissions": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "base",
            "autoApprove",
            "deny",
            "permissionMode",
            "allowDangerouslySkipPermissions"
          ],
          "additionalProperties": false
        },
        "requireApproval": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "handoff": {
          "type": "boolean",
          "const": true
        },
        "skills": {
          "oneOf": [
            {
              "readOnly": true,
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "all"
                }
              },
              "required": ["mode"],
              "additionalProperties": false
            },
            {
              "readOnly": true,
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "allowlist"
                },
                "names": {
                  "readOnly": true,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
                  }
                }
              },
              "required": ["mode", "names"],
              "additionalProperties": false
            }
          ]
        },
        "limits": {
          "readOnly": true,
          "type": "object",
          "properties": {
            "maxTurns": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxBudgetUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["maxTurns", "maxBudgetUsd"],
          "additionalProperties": false
        }
      },
      "required": ["engine", "tools", "skills", "limits"],
      "additionalProperties": false
    },
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "const": "openai-agents"
        },
        "reasoningEffort": {
          "type": "string",
          "enum": ["minimal", "low", "medium", "high"]
        },
        "parallelToolCalls": {
          "type": "boolean"
        },
        "withheldPermissions": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["readFiles", "writeFiles", "runCommands", "unrestrictedNetwork"]
          }
        },
        "skills": {
          "oneOf": [
            {
              "readOnly": true,
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "all"
