                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["maxTurns", "maxBudgetUsd"],
          "additionalProperties": false
        }
      },
      "required": ["engine", "skills", "limits"],
      "additionalProperties": false
    },
    {
      "readOnly": true,
      "type": "object",
      "properties": {
        "engine": {
