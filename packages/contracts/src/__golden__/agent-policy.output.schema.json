                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxBudgetUsd": {
              "anyOf": [
                {
                  "type": "number",
