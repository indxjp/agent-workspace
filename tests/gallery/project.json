        "{workspaceRoot}/tests/docs-claims/use-cases.mjs",
        "{workspaceRoot}/tests/docs-claims/use-cases-console.mjs",
        "{workspaceRoot}/tests/docs-claims/use-cases-parse.mjs",
        "{workspaceRoot}/tests/docs-claims/use-cases-project.mjs",
        "{workspaceRoot}/tests/docs-claims/use-cases-server.mjs",
        "{workspaceRoot}/tests/generated-project/fake-anthropic.mjs",
        "{workspaceRoot}/tests/generated-project/images.mjs",
        "{workspaceRoot}/tests/generated-project/project.mjs",
        "{workspaceRoot}/tests/generated-project/run.mjs",
        "{workspaceRoot}/tests/journey/fake-anthropic-tools.mjs",
