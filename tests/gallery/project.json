{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tests-gallery",
  "implicitDependencies": ["!agent-workspace", "!tests"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project tests-gallery --reporter=default --reporter=json --outputFile={projectRoot}/.vitest-report.json",
        "env": {
          "NODE_OPTIONS": "--unhandled-rejections=strict",
          "VITEST_MAX_WORKERS": "4"
        }
      },
      "inputs": [
        "default",
        "^default",
        "vitestConfig",
        "{workspaceRoot}/tests/projects.mjs",
        "{workspaceRoot}/tests/vitest.shared.ts",
        "{workspaceRoot}/.claude/**/*",
        "{workspaceRoot}/CHANGELOG.md",
        "{workspaceRoot}/Dockerfile",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/apps/web/server/runs/transcription.ts",
        "{workspaceRoot}/docs/sdk/site/**/*",
        "{workspaceRoot}/egress-proxy.Dockerfile",
        "{workspaceRoot}/gateway.Dockerfile",
        "{workspaceRoot}/infra/release/images.mjs",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/playwright.generated-project.config.mjs",
        "{workspaceRoot}/playwright.journey.config.mjs",
        "{workspaceRoot}/runtime.Dockerfile",
        "{workspaceRoot}/scripts/engine-images.mjs",
        "{workspaceRoot}/scripts/release/boot-smoke.mjs",
        "{workspaceRoot}/scripts/release/consumer-process.mjs",
        "{workspaceRoot}/scripts/release/pack-packages.mjs",
        "{workspaceRoot}/scripts/release/package-smoke.mjs",
        "{workspaceRoot}/scripts/release/package-tar.mjs",
        "{workspaceRoot}/sites/lp/**/*",
        "{workspaceRoot}/tests/apps/benchmark.ts",
        "{workspaceRoot}/tests/apps/handwritten.ts",
        "{workspaceRoot}/tests/apps/lane.mjs",
        "{workspaceRoot}/tests/docs-claims/extract.mjs",
        "{workspaceRoot}/tests/docs-claims/host.mjs",
