{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tests-conformance",
  "implicitDependencies": ["!agent-workspace"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project tests-conformance --reporter=default --reporter=json --outputFile={projectRoot}/.vitest-report.json",
        "env": {
          "NODE_OPTIONS": "--unhandled-rejections=strict",
          "VITEST_MAX_WORKERS": "4"
        }
      },
      "inputs": [
        "default",
        "^default",
        "vitestConfig",
        "{workspaceRoot}/tests/projects.mjs",
        "{workspaceRoot}/tests/vitest.shared.ts",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/docs/spec.md"
      ]
    }
  }
}
