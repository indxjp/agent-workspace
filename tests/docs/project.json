{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tests-docs",
  "implicitDependencies": ["!agent-workspace", "!tests"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project tests-docs --reporter=default --reporter=json --outputFile={projectRoot}/.vitest-report.json",
        "env": {
          "NODE_OPTIONS": "--unhandled-rejections=strict",
          "VITEST_MAX_WORKERS": "4"
        }
      },
      "inputs": [
        "default",
        "^default",
        "vitestConfig",
        "{workspaceRoot}/tests/projects.mjs",
        "{workspaceRoot}/tests/vitest.shared.ts",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CLAUDE.md",
        "{workspaceRoot}/ENGINEERING_GUIDELINES.md",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/apps/web/**/*",
        "{workspaceRoot}/docs/30-reference/capabilities/capability-status.md",
        "{workspaceRoot}/docs/30-reference/matrices/runtime-driver-matrix.md",
        "{workspaceRoot}/docs/30-reference/policies/dependency-policy.md",
        "{workspaceRoot}/docs/30-reference/policies/testing-strategy.md",
        "{workspaceRoot}/docs/30-reference/policies/upgrade-policy.md",
        "{workspaceRoot}/docs/README.md",
        "{workspaceRoot}/docs/adr/**/*",
        "{workspaceRoot}/docs/architecture.md",
        "{workspaceRoot}/docs/20-design/architecture/refactoring/claude-agent-workspace-refactoring-decisions.md",
        "{workspaceRoot}/docs/20-design/architecture/refactoring/claude-agent-workspace-refactoring-plan.md",
        "{workspaceRoot}/docs/20-design/architecture/ssot/ARCHITECTURE.md",
        "{workspaceRoot}/docs/40-operate/deploy/azure-container-apps.md",
        "{workspaceRoot}/docs/40-operate/deploy/kubernetes.md",
        "{workspaceRoot}/docs/40-operate/deploy/single-vm.md",
        "{workspaceRoot}/docs/40-operate/operations/runbook.md",
        "{workspaceRoot}/docs/10-product/sdk/02-use-cases-and-documentation.md",
        "{workspaceRoot}/docs/10-product/sdk/03-sdk-design.md",
        "{workspaceRoot}/docs/10-product/sdk/04-api-specification.md",
        "{workspaceRoot}/docs/10-product/sdk/07-structure-map.md",
        "{workspaceRoot}/docs/10-product/sdk/README.md",
        "{workspaceRoot}/docs/10-product/sdk/api/**/*",
        "{workspaceRoot}/docs/sdk/site/**/*",
        "{workspaceRoot}/docs/spec.md",
        "{workspaceRoot}/llms.txt",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/scripts/docs/adr-index.mjs",
        "{workspaceRoot}/scripts/docs/check-front-door.mjs",
        "{workspaceRoot}/scripts/docs/check-links.mjs",
        "{workspaceRoot}/scripts/docs/generate-api-reports.mjs",
        "{workspaceRoot}/scripts/docs/lib/api-reports-compare.mjs",
        "{workspaceRoot}/scripts/docs/generate-llms-txt.mjs",
        "{workspaceRoot}/scripts/docs/generate-openapi.mjs",
        "{workspaceRoot}/scripts/docs/generate-sdk-reference.mjs",
        "{workspaceRoot}/scripts/docs/lib/class-props.mjs",
        "{workspaceRoot}/scripts/docs/lib/families.mjs",
        "{workspaceRoot}/scripts/docs/lib/literal-values.mjs",
        "{workspaceRoot}/scripts/docs/lib/mdx.mjs",
        "{workspaceRoot}/scripts/docs/lib/openapi-bodies.mjs",
        "{workspaceRoot}/scripts/docs/lib/openapi-contracts.mjs",
        "{workspaceRoot}/scripts/docs/lib/openapi-shared-components.mjs",
        "{workspaceRoot}/scripts/docs/lib/render-cli.mjs",
        "{workspaceRoot}/scripts/docs/lib/render-client.mjs",
        "{workspaceRoot}/scripts/docs/lib/render-contracts.mjs",
        "{workspaceRoot}/scripts/docs/lib/render-events.mjs",
        "{workspaceRoot}/scripts/docs/lib/render-families.mjs",
        "{workspaceRoot}/scripts/docs/lib/ts-doc.mjs",
        "{workspaceRoot}/scripts/docs/lib/ts-nodes.mjs",
        "{workspaceRoot}/scripts/docs/lib/ts-project.mjs",
        "{workspaceRoot}/scripts/docs/lib/type-render.mjs",
        "{workspaceRoot}/scripts/docs/lib/zod-shape.mjs",
        "{workspaceRoot}/tests/inventory-support.ts",
        "{workspaceRoot}/tests/route-declarations/**/*"
      ]
    }
  }
}
