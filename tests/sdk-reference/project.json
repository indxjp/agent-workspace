{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tests-sdk-reference",
  "implicitDependencies": [
    "!agent-workspace",
    "!tests",
    "@indx-workspace/contracts",
    "@indx-workspace/sdk",
    "@indx-workspace/aw"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project tests-sdk-reference --reporter=default --reporter=json --outputFile={projectRoot}/.vitest-report.json",
        "env": {
          "NODE_OPTIONS": "--unhandled-rejections=strict",
          "VITEST_MAX_WORKERS": "4"
        }
      },
      "inputs": [
        "default",
        "^default",
        "vitestConfig",
        "{workspaceRoot}/tests/projects.mjs",
        "{workspaceRoot}/tests/vitest.shared.ts",
        "{workspaceRoot}/tests/docs/generate-sdk-reference.test.ts",
        "{workspaceRoot}/scripts/docs/generate-sdk-reference.mjs",
        "{workspaceRoot}/scripts/docs/lib/**/*",
        "{workspaceRoot}/docs/sdk/site/reference/**/*"
      ]
    }
  }
}
