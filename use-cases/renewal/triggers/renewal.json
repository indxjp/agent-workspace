{
  "kind": "schedule",
  "name": "renewal",
  "prompt": "今日時点の契約更新リマインドを作成して、renewal-reports フォルダに保存してください。 / Write today's renewal reminder and save it to the renewal-reports folder.",
  "cron": "0 9 * * 1-5",
  "timezone": "Asia/Tokyo",
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["date", "contracts", "savedTo"],
    "properties": {
      "date": { "type": "string" },
      "contracts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "account",
            "endDate",
            "daysToEnd",
            "urgent",
            "owner",
            "draft",
            "sources"
          ],
          "properties": {
            "contract": { "type": "string" },
            "account": { "type": "string" },
            "endDate": { "type": "string" },
            "daysToEnd": { "type": "integer" },
            "urgent": { "type": "boolean" },
            "owner": { "type": "string" },
            "draft": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to", "subject", "body"],
              "properties": {
                "to": { "type": "string" },
                "subject": { "type": "string" },
                "body": { "type": "string" }
              }
            },
            "sources": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "savedTo": { "type": "string" }
    }
  }
}
