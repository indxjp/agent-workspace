{
  "kind": "schedule",
  "name": "competitor",
  "prompt": "今週の競合比較レポートを作成して、competitor-reports フォルダに保存してください。 / Write this week's competitor comparison report and save it to the competitor-reports folder.",
  "cron": "0 9 * * 1",
  "timezone": "Asia/Tokyo",
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["date", "asOf", "changes", "savedTo"],
    "properties": {
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "changes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["row", "release", "item", "before", "after", "from"],
          "properties": {
            "row": { "type": "string", "pattern": "^C-\\d{2}$" },
            "release": { "type": "string", "pattern": "^[A-Z]{3}-\\d{3}$" },
            "item": { "type": "string" },
            "before": { "type": "string" },
            "after": { "type": "string" },
            "from": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      },
      "savedTo": { "type": "string" }
    }
  }
}
