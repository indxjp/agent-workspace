# Normalise line endings so a clone on Windows (git's default core.autocrlf=true)
# checks out the same bytes Prettier formatted, and `pnpm format:check` passes
# everywhere. Without this, every text file arrives with CRLF and Prettier
# reports all of them as unformatted.
* text=auto eol=lf

# Generated by pnpm; keep it LF and mark it generated so review UIs collapse it
# by default (but still diffable on demand - no `-diff`).
pnpm-lock.yaml text eol=lf linguist-generated=true

# Binary assets: never translate line endings or attempt a text diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary

# Generated outputs. Marked so review UIs collapse them and the PR size gate
# (scripts/ci/check-pr-size.mjs) does not count them.
llms.txt linguist-generated=true
docs/sdk/site/openapi.json linguist-generated=true
docs/sdk/site/reference/** linguist-generated=true
migrations/meta/** linguist-generated=true
formal/generated/** linguist-generated=true
**/__golden__/** linguist-generated=true
tests/e2e/platforms-journey/golden/** linguist-generated=true
