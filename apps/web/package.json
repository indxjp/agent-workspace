{
  "name": "@agent-workspace/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./server/cli-auth/local-credential": "./server/cli-auth/local-credential.ts",
    "./server/start": "./server/start.ts"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-workspace/core --filter @indx-workspace/react... build && next dev",
    "build": "pnpm --filter @agent-workspace/core --filter @indx-workspace/react... build && next build",
    "start": "pnpm run build && next start",
    "typecheck": "next typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-workspace/core": "workspace:*",
    "@agent-workspace/gateway": "workspace:*",
    "@agent-workspace/run-protocol": "workspace:*",
    "@agent-workspace/runtime": "workspace:*",
    "@agent-workspace/skills-office": "workspace:*",
    "@indx-workspace/contracts": "workspace:*",
    "@indx-workspace/platforms": "workspace:*",
    "@indx-workspace/react": "workspace:*",
    "@indx-workspace/sdk": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "croner": "10.0.1",
    "jose": "6.2.13",
    "next": "16.4.3",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agent-workspace/engine-claude-agent-sdk": "workspace:*",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/credential-provider-web-identity": "3.972.83",
    "@indx-workspace/aw": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-orm": "0.45.4",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "next build",
          "cwd": "apps/web"
        },
        "//outputs": "next-env.d.ts is generated by next build (and gitignored), and it is what brings .next/types/routes.d.ts, and with it the global RouteContext, into the TypeScript program. Without it declared here a cache replay restores .next but not this file, and type-aware lint/typecheck of every route handler typed with RouteContext fails (main run 36943866830; docs/adr/0110).",
        "outputs": [
          "{projectRoot}/.next",
          "!{projectRoot}/.next/cache",
          "{projectRoot}/next-env.d.ts"
        ]
      },
      "typecheck": {
        "//": "typecheck and lint run after @indx-workspace/embedded:build, which briefly rewrites this project's tsconfig.json and writes .next-embedded (packages/embedded/package.json explains the direction of this edge).",
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@indx-workspace/embedded"
            ],
            "target": "build"
          }
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "^build",
          {
            "projects": [
              "@indx-workspace/embedded"
            ],
            "target": "build"
          }
        ],
        "options": {
          "command": "eslint apps/web --max-warnings 0"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --project @agent-workspace/web --reporter=default --reporter=json --outputFile={projectRoot}/.vitest-report.json",
          "env": {
            "NODE_OPTIONS": "--unhandled-rejections=strict",
            "VITEST_MAX_WORKERS": "4"
          }
        },
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
