{
  "name": "@agent-workspace/runner",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./start": {
      "types": "./src/start.ts",
      "default": "./dist/start.js"
    },
    "./manager-start": {
      "types": "./src/manager-start.ts",
      "default": "./dist/manager-start.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:manager": "node dist/manager-start.js",
    "typecheck": "pnpm --filter @agent-workspace/core run build && pnpm run build && tsc -p tsconfig.json",
    "start": "pnpm --filter @agent-workspace/core run build && pnpm run build && node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@agent-workspace/core": "workspace:*",
    "@agent-workspace/engine": "workspace:*",
    "@agent-workspace/runtime": "workspace:*",
    "@indx-workspace/contracts": "workspace:*",
    "zod": "4.6.6"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -p tsconfig.json",
          "cwd": "apps/runner"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint apps/runner --max-warnings 0"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --project @agent-workspace/runner --reporter=default --reporter=json --outputFile={projectRoot}/.vitest-report.json",
          "env": {
            "NODE_OPTIONS": "--unhandled-rejections=strict",
            "VITEST_MAX_WORKERS": "4"
          }
        }
      }
    }
  }
}
