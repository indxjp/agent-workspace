#!/bin/sh
set -eu
umask 077

secret_dir=/run/agent-workspace/secrets
install -d -m 0700 "$secret_dir"

read_secret() {
  secret="$1"
  version="$2"
  case "$version" in ''|*[!0-9]*|0) echo "numbered secret version required for $secret" >&2; exit 1 ;; esac
  gcloud secrets versions access "$version" --project '${project_id}' --secret "$secret"
}

postgres_password="$(read_secret agent-workspace-postgres-password '${secret_versions.postgres_password}')"
session_secret="$(read_secret agent-workspace-session-secret '${secret_versions.session_secret}')"
master_key="$(read_secret agent-workspace-master-encryption-key '${secret_versions.master_encryption_key}')"
gateway_secret="$(read_secret agent-workspace-gateway-token-secret '${secret_versions.gateway_token_secret}')"
runner_manager_token="$(read_secret agent-workspace-runner-manager-token '${secret_versions.runner_manager_token}')"
admin_password="$(read_secret agent-workspace-bootstrap-admin-password '${secret_versions.bootstrap_admin_password}')"

case "$postgres_password" in *[!A-Za-z0-9_-]*|'') echo 'postgres password must be base64url-safe' >&2; exit 1 ;; esac
[ "$${#session_secret}" -ge 32 ] || { echo 'session secret is too short' >&2; exit 1; }
[ "$${#master_key}" -ge 32 ] || { echo 'master encryption key is too short' >&2; exit 1; }
[ "$${#gateway_secret}" -ge 32 ] || { echo 'gateway token secret is too short' >&2; exit 1; }
[ "$${#runner_manager_token}" -ge 32 ] || { echo 'runner manager token is too short' >&2; exit 1; }
[ "$${#admin_password}" -ge 12 ] || { echo 'bootstrap administrator password is too short' >&2; exit 1; }

cat >"$secret_dir/postgres.env" <<EOF
POSTGRES_USER=agent_workspace
POSTGRES_PASSWORD=$postgres_password
POSTGRES_DB=agent_workspace
POSTGRES_INITDB_ARGS=--locale-provider=icu --icu-locale=en-US --encoding=UTF8
EOF
cat >"$secret_dir/gateway.env" <<EOF
DATABASE_URL=postgres://agent_workspace:$postgres_password@postgres:5432/agent_workspace
MASTER_ENCRYPTION_KEY=$master_key
GATEWAY_TOKEN_SECRET=$gateway_secret
GATEWAY_PRICING_JSON=$(printf '%s' '${gateway_pricing_json_base64}' | base64 --decode)
EOF
cat >"$secret_dir/web.env" <<EOF
DATABASE_URL=postgres://agent_workspace:$postgres_password@postgres:5432/agent_workspace
MASTER_ENCRYPTION_KEY=$master_key
GATEWAY_TOKEN_SECRET=$gateway_secret
RUNNER_MANAGER_TOKEN=$runner_manager_token
SESSION_SECRET=$session_secret
BOOTSTRAP_ADMIN=${bootstrap_admin_email}
BOOTSTRAP_ADMIN_PASSWORD=$admin_password
WORKSPACE_SLUG=default
WORKSPACE_NAME=Default Workspace
EOF
cat >"$secret_dir/runner.env" <<EOF
AW_SESSION_MIRROR_URL=http://web:3000
RUNNER_MANAGER_TOKEN=$runner_manager_token
EOF
chmod 0600 "$secret_dir"/*.env
unset postgres_password session_secret master_key gateway_secret runner_manager_token admin_password
